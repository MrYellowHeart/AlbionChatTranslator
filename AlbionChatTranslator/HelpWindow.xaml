<Window x:Class="AlbionChatTranslator.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How to use Albion Chat Translator"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A">

    <StackPanel Margin="24">

        <!-- Header -->
        <TextBlock Text="Albion Chat Translator" Foreground="#6A9FB5"
                   FontFamily="Consolas" FontSize="16" FontWeight="Bold" Margin="0,0,0,2"/>
        <TextBlock Text="by Tenith" Foreground="#555" FontFamily="Consolas"
                   FontSize="11" Margin="0,0,0,16"/>

        <!-- Step 1 -->
        <TextBlock Text="1 · Get a free DeepL API key" Foreground="#D0D0D0"
                   FontFamily="Consolas" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="#999" FontFamily="Consolas" FontSize="11"
                   Margin="12,0,0,12">
            <Hyperlink NavigateUri="https://www.deepl.com/en/pro-api#api-pricing"
                RequestNavigate="Link_RequestNavigate" Foreground="#6A9FB5">Sign up for free</Hyperlink>
            <Run> · then · </Run>
            <Hyperlink NavigateUri="https://www.deepl.com/en/your-account/keys"
                RequestNavigate="Link_RequestNavigate" Foreground="#6A9FB5">get your API key</Hyperlink>
            <Run>&#x0a;The free tier gives you 500,000 characters/month — more than enough.</Run>
        </TextBlock>

        <!-- Step 2 -->
        <TextBlock Text="2 · Run as Administrator and click ▶ Start"
                   Foreground="#D0D0D0" FontFamily="Consolas" FontSize="13"
                   FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="#999" FontFamily="Consolas" FontSize="11"
                   Margin="12,0,0,12">
            Raw packet capture requires elevated privileges. Right-click the exe and
            choose "Run as Administrator", then paste your key and hit Start.
        </TextBlock>

        <!-- Step 3 -->
        <TextBlock Text="3 · Populate your chat tabs" Foreground="#D0D0D0"
                   FontFamily="Consolas" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="#999" FontFamily="Consolas" FontSize="11"
                   Margin="12,0,0,12">
            Log in to Albion Online while the translator is capturing — your chat tab
            layout will be detected automatically and tabs will appear here.
        </TextBlock>

        <!-- Step 4 -->
        <TextBlock Text="4 · Toggle tabs in ⚙ Settings" Foreground="#D0D0D0"
                   FontFamily="Consolas" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="#999" FontFamily="Consolas" FontSize="11"
                   Margin="12,0,0,16">
            Use the Settings page to enable or disable individual tabs and to control
            whether global channels (faction, English, Help) are shown.
            Your preferences are saved between sessions.
        </TextBlock>

        <Separator/>

        <Button Content="Got it!" IsDefault="True" Click="BtnClose_Click"
                HorizontalAlignment="Right" Width="100" Margin="0,8,0,0"
                Background="#2D5A8E" Foreground="White" BorderBrush="#3A6EA8"/>

    </StackPanel>
</Window>
