<Window x:Class="AlbionChatTranslator.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AlbionChatTranslator"
        Title="Chat overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        ResizeMode="CanResizeWithGrip" MinWidth="240" MinHeight="80">

    <Border x:Name="Frame" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent">
        <Border.Background>
            <SolidColorBrush x:Name="BackgroundBrush" Color="#101010" Opacity="0.75"/>
        </Border.Background>
        <DockPanel>
            <TextBlock x:Name="TxtUnlocked" DockPanel.Dock="Top" Visibility="Collapsed" Foreground="#C8E6A0" FontSize="11"
                       Margin="8,4" Text="Unlocked: drag to move, drag the corner to resize. Ctrl+Shift+L locks it."/>
            <ListBox x:Name="Feed" Background="Transparent" BorderThickness="0" Padding="6,4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter Margin="0,0,0,2"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ChatEntry}">
                        <TextBlock TextWrapping="Wrap" FontSize="13">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.9" Color="Black"/>
                            </TextBlock.Effect>
                            <Run Text="{Binding Sender, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}" FontWeight="SemiBold"/><Run
                                 Text="{Binding Text, Mode=OneWay}" Foreground="#F0F0F0"/><Run
                                 Text="{Binding Tag, Mode=OneWay}" Foreground="#909090"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
