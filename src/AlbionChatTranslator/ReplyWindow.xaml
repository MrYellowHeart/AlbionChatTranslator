<Window x:Class="AlbionChatTranslator.ReplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reply in their language"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <StackPanel Margin="16">
        <DockPanel Margin="0,0,0,6">
            <TextBlock Text="Translate into:" Foreground="#999" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="CboTarget" DisplayMemberPath="Name" Height="24"/>
        </DockPanel>

        <TextBox x:Name="TxtInput" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                 ToolTip="Write in your own language. Enter translates and copies."/>

        <Button x:Name="BtnTranslate" Content="→ Translate and copy" Click="BtnTranslate_Click" HorizontalAlignment="Left"
                Padding="10,4" Margin="0,0,0,8" Style="{StaticResource PrimaryButton}"/>

        <TextBox x:Name="TxtOutput" Height="80" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="#111" Foreground="#C8E6A0" Margin="0,0,0,6"/>

        <TextBlock x:Name="TxtInfo" Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Copy" Click="BtnCopy_Click" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Close" IsCancel="True" Width="70" Click="BtnClose_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
