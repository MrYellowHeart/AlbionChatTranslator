<Window x:Class="AlbionChatTranslator.ReplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reply Composer"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        Background="#1E1E1E">

    <StackPanel Margin="16">

        <TextBlock x:Name="TxtLabel"
                   Foreground="#999" FontFamily="Consolas" FontSize="11"
                   Margin="0,0,0,6" TextWrapping="Wrap"/>

        <!-- Input -->
        <TextBox x:Name="TxtInput"
                 Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto"
                 Background="#141414" Foreground="#D0D0D0"
                 BorderBrush="#444" Padding="4"
                 Margin="0,0,0,8"/>

        <Button Content="→ Translate" Click="BtnTranslate_Click"
                HorizontalAlignment="Left" Padding="10,4"
                Background="#2D5A8E" Foreground="White" BorderBrush="#3A6EA8"
                Margin="0,0,0,8"/>

        <!-- Output -->
        <TextBox x:Name="TxtOutput"
                 Height="80" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto"
                 Background="#111" Foreground="#C8E6A0"
                 BorderBrush="#333" Padding="4"
                 Margin="0,0,0,8"/>

        <TextBlock x:Name="TxtError"
                   Foreground="#C05050" FontFamily="Consolas" FontSize="10"
                   TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Copy to clipboard" Click="BtnCopy_Click"
                    Padding="10,4" Margin="0,0,8,0"
                    Background="#3A3A3A" Foreground="#D0D0D0" BorderBrush="#555"/>
            <Button Content="Close" IsCancel="True" Width="70" Click="BtnClose_Click"
                    Padding="8,4"/>
        </StackPanel>

    </StackPanel>
</Window>
