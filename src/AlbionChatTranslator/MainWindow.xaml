<Window x:Class="AlbionChatTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AlbionChatTranslator"
        Title="Albion Chat Translator"
        Icon="Assets/app.ico"
        Height="520" Width="780" MinHeight="300" MinWidth="460"
        Background="{StaticResource WindowBg}">

    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="#1E1E1E" Margin="0,4,0,0"/>
                            <Border Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="#333" BorderThickness="0,1,0,0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#232323"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#333"
                                BorderThickness="1,1,1,0" CornerRadius="3,3,0,0"
                                Padding="{TemplateBinding Padding}" Margin="0,0,3,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#141414"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TabHeader" DataType="{x:Type local:ChatTabViewModel}">
            <TextBlock Text="{Binding Name}" Foreground="{Binding HeaderBrush}" FontFamily="{StaticResource Mono}" FontSize="12"/>
        </DataTemplate>

        <DataTemplate x:Key="TabContent" DataType="{x:Type local:ChatTabViewModel}">
            <ListBox ItemsSource="{Binding Entries}" Background="{StaticResource PanelBg}" BorderThickness="0"
                     Padding="6" Loaded="ChatList_Loaded"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0,0,0,1"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ChatEntry}">
                        <TextBlock TextWrapping="Wrap" FontFamily="{StaticResource Mono}" FontSize="12" ToolTip="{Binding Tooltip}">
                            <Run Text="{Binding Time, Mode=OneWay}" Foreground="#777"/>
                            <Run Text="{Binding Sender, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}" FontWeight="SemiBold"/><Run
                                 Text="{Binding Text, Mode=OneWay}" Foreground="{Binding Brush, Mode=OneWay}"/><Hyperlink
                                 Click="LanguageTag_Click" Foreground="#777" TextDecorations="{x:Null}"
                                 ToolTip="Reply in this language"><Run Text="{Binding Tag, Mode=OneWay}"/></Hyperlink>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="8">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="BtnStart" Content="▶ Start" Click="BtnStart_Click" Margin="0,0,4,0" Style="{StaticResource PrimaryButton}"/>
            <Button x:Name="BtnStop" Content="■ Stop" Click="BtnStop_Click" Margin="0,0,8,0" IsEnabled="False"/>
            <Button Content="Reply…" Click="BtnReply_Click" Margin="0,0,4,0" ToolTip="Write a message in your language and translate it"/>
            <Button Content="Clear" Click="BtnClear_Click" Margin="0,0,4,0"/>
            <Button Content="⚙ Settings" Click="BtnSettings_Click" Margin="0,0,4,0"/>
            <Button Content="?" Click="BtnHelp_Click" Margin="0,0,8,0" ToolTip="Help"/>
            <TextBlock x:Name="TxtStatus" Text="Stopped" Foreground="#777" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>

        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="#203A20" Padding="8,4" Margin="0,0,0,6" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restart now" Click="BtnApplyUpdate_Click" Padding="8,2"/>
                <TextBlock x:Name="TxtUpdate" Foreground="#C8E6A0" VerticalAlignment="Center" FontSize="11"/>
            </DockPanel>
        </Border>

        <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Messages: " Foreground="#555" FontSize="10"/>
                <TextBlock x:Name="TxtCount" Text="0" Foreground="{StaticResource Accent}" FontSize="10" Margin="0,0,12,0"/>
                <TextBlock Text="Sent for translation: " Foreground="#555" FontSize="10"
                           ToolTip="Lines that left your PC. Lines in your own language, short lines and repeats are never sent."/>
                <TextBlock x:Name="TxtSent" Text="0" Foreground="{StaticResource Accent}" FontSize="10" Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtActivity" Foreground="#888" FontSize="10" Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtError" Foreground="{StaticResource Error}" FontSize="10"/>
            </StackPanel>
            <TextBlock x:Name="TxtProvider" HorizontalAlignment="Right" Foreground="#555" FontSize="10"/>
        </Grid>

        <TabControl x:Name="Tabs" ItemTemplate="{StaticResource TabHeader}" ContentTemplate="{StaticResource TabContent}"/>
    </DockPanel>
</Window>
