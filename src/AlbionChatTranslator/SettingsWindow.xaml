<Window x:Class="AlbionChatTranslator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="460" Height="720" MinHeight="400"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <DockPanel Margin="20,10,20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="80" Margin="0,0,8,0" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="TRANSLATE CHAT INTO" Style="{StaticResource SectionHeader}"/>
                <ComboBox x:Name="CboLanguage" DisplayMemberPath="Name" Height="26"/>

                <TextBlock Text="SERVER AND CHAT LANGUAGES" Style="{StaticResource SectionHeader}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Server you play on:"/>
                <ComboBox x:Name="CboServer" Height="24"/>
                <TextBlock x:Name="TxtServerHint" Style="{StaticResource Hint}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Languages you see in chat (their offline packs are kept ready):"/>
                <WrapPanel x:Name="LanguagesPanel"/>
                <TextBlock x:Name="TxtPackSummary" Style="{StaticResource Hint}"/>

                <TextBlock Text="I CAN ALSO READ" Style="{StaticResource SectionHeader}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Messages in these languages are shown as-is and never sent for translation."/>
                <WrapPanel x:Name="ReadLanguagesPanel"/>

                <TextBlock Text="WHEN TO TRANSLATE" Style="{StaticResource SectionHeader}"/>
                <RadioButton x:Name="RbAuto" GroupName="Mode" Content="Automatically"/>
                <RadioButton x:Name="RbOnClick" GroupName="Mode" Content="Only when I click [translate] on a message (most private)"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,2" Text="Never send messages from these channels:"/>
                <WrapPanel>
                    <CheckBox x:Name="CbNoWhisper" Content="Whispers" Margin="0,3,14,3"/>
                    <CheckBox x:Name="CbNoParty" Content="Party" Margin="0,3,14,3"/>
                    <CheckBox x:Name="CbNoGuild" Content="Guild" Margin="0,3,14,3"/>
                    <CheckBox x:Name="CbNoAlliance" Content="Alliance" Margin="0,3,14,3"/>
                    <CheckBox x:Name="CbNoSay" Content="Say" Margin="0,3,14,3"/>
                    <CheckBox x:Name="CbNoOther" Content="Other channels" Margin="0,3,14,3"/>
                </WrapPanel>

                <TextBlock Text="TRANSLATORS (TRIED IN THIS ORDER)" Style="{StaticResource SectionHeader}"/>

                <TextBlock Text="1. Your own key (optional, most reliable)" Foreground="#D0D0D0" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Hint}" Text="An official service with a free monthly allowance. Recommended if you translate a lot."/>
                <ComboBox x:Name="CboKeyService" Height="24" Margin="0,2,0,4" SelectionChanged="CboKeyService_SelectionChanged">
                    <ComboBoxItem Content="None"/>
                    <ComboBoxItem Content="Microsoft Translator (2,000,000 characters free)"/>
                    <ComboBoxItem Content="DeepL (500,000 characters/month free)"/>
                </ComboBox>
                <StackPanel x:Name="KeyPanel">
                    <TextBlock Style="{StaticResource Hint}" Text="Key:"/>
                    <PasswordBox x:Name="TxtKey" Height="24"/>
                    <StackPanel x:Name="RegionPanel">
                        <TextBlock Style="{StaticResource Hint}" Text="Region (as shown in Azure, e.g. westeurope; leave empty for a global resource):"/>
                        <TextBox x:Name="TxtRegion" Height="24"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">
                        <Hyperlink x:Name="LinkKeyHelp" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource Accent}">How to get a free key</Hyperlink>
                        <Run Text=" · stored encrypted with your Windows account"/>
                    </TextBlock>
                </StackPanel>

                <CheckBox x:Name="CbOffline" Margin="0,10,0,0" Content="2. Offline models on your PC (recommended)"/>
                <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,4"
                           Text="Nothing is sent. Packs for the languages you picked above download once (about 110 MB each); other languages download the first time they appear. Uses about 200 MB more memory only while translating."/>

                <CheckBox x:Name="CbUseGoogle" Content="3. Google Translate, for languages without an offline model"/>
                <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,4"
                           Text="Free and no setup, but Google limits it quickly, so it is used last. Only the message text is sent."/>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBlock x:Name="TxtPacks" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Delete offline packs" Padding="6,1" FontSize="11" Click="BtnDeletePacks_Click"/>
                </StackPanel>

                <TextBlock Text="NEVER TRANSLATE THESE WORDS" Style="{StaticResource SectionHeader}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Guild names, friends' names, your own slang. Separate with commas. Albion cities, tiers and item links are already protected."/>
                <TextBox x:Name="TxtCustomTerms" Height="48" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="MEMORY" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="CbKeepCache" Content="Remember translations for 7 days (fewer messages sent)"/>
                <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,4" Text="Stores translated messages on this PC so repeats are not sent again after a restart. Off by default because the file contains other players' messages."/>
                <Button Content="Forget all translations" HorizontalAlignment="Left" Padding="8,2" FontSize="11" Margin="20,0,0,0" Click="BtnClearCache_Click"/>

                <TextBlock Text="OVERLAY" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Background" Foreground="#D0D0D0" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="SliderOpacity" Minimum="0" Maximum="1" Width="200" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox x:Name="CbOverlayTranslatedOnly" Content="Show only translated messages in the overlay"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Hotkeys (work while Albion has focus): Ctrl+Shift+R reply · Ctrl+Shift+O show/hide overlay · Ctrl+Shift+L unlock overlay to move it."/>

                <TextBlock Text="CHAT" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="CbGlobal" Content="Translate global channels automatically (Help, Looking for group, Recruit, trade…)"/>
                <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,4" Text="They are always shown in their tabs. When this is off, click [translate] on a message to translate it; this keeps busy global chat from using up the translators' limits."/>
                <CheckBox x:Name="CbTopmost" Content="Keep this window on top of the game"/>
                <CheckBox x:Name="CbOnTopOnlyWithGame" Margin="20,0,0,0" Content="Only while Albion (or this app) is in front: hide the overlay when I switch to other programs"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Skip messages with fewer letters than" Foreground="#D0D0D0" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtMinLetters" Width="36" Margin="8,0,0,0" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="TROUBLESHOOTING" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="CbDiagnostics" Content="Write a diagnostic log (channel numbers, routing, timings; never message text or names)"/>
                <Button Content="Open log folder" HorizontalAlignment="Left" Padding="8,2" FontSize="11" Margin="20,2,0,0" Click="BtnOpenLogFolder_Click"/>

                <TextBlock Text="TABS" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="TxtNoTabs" Style="{StaticResource Hint}"
                           Text="Your in-game chat tabs appear here after you log in to Albion while capturing."/>
                <StackPanel x:Name="TabPanel"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
