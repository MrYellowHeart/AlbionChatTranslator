<Window x:Class="AlbionChatTranslator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="460" Height="720" MinHeight="400"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <DockPanel Margin="20,10,20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="80" Margin="0,0,8,0" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="TRANSLATE CHAT INTO" Style="{StaticResource SectionHeader}"/>
                <ComboBox x:Name="CboLanguage" DisplayMemberPath="Name" Height="26"/>

                <TextBlock Text="I CAN ALSO READ" Style="{StaticResource SectionHeader}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Messages in these languages are shown as-is and never sent for translation."/>
                <WrapPanel x:Name="ReadLanguagesPanel"/>

                <TextBlock Text="WHEN TO TRANSLATE" Style="{StaticResource SectionHeader}"/>
                <RadioButton x:Name="RbAuto" GroupName="Mode" Content="Automatically"/>
                <RadioButton x:Name="RbOnClick" GroupName="Mode" Content="Only when I click [translate] on a message (most private)"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,2" Text="Never send messages from these channels:"/>
                <WrapPanel>
                    <CheckBox x:Name="CbNoWhisper" Content="Whispers" Margin="0,3,14,3"/>
                    <CheckBox x:Name="CbNoParty" Content="Party" Margin="0,3,14,3"/>
                    <CheckBox x:Name="CbNoGuild" Content="Guild" Margin="0,3,14,3"/>
                    <CheckBox x:Name="CbNoAlliance" Content="Alliance" Margin="0,3,14,3"/>
                    <CheckBox x:Name="CbNoSay" Content="Say" Margin="0,3,14,3"/>
                    <CheckBox x:Name="CbNoOther" Content="Other channels" Margin="0,3,14,3"/>
                </WrapPanel>

                <TextBlock Text="TRANSLATOR" Style="{StaticResource SectionHeader}"/>
                <RadioButton x:Name="RbGoogle" GroupName="Provider" Content="Google Translate (recommended): free, no account"/>
                <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,8"
                           Text="Only the text of messages that are not in your languages is sent. Never names, channels, item links or anything about you."/>
                <RadioButton x:Name="RbDeepL" GroupName="Provider" Content="DeepL: needs your own API key"/>
                <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,4"
                           Text="Often more natural for European languages. Free key: 500,000 characters/month. Stored encrypted with your Windows account."/>
                <PasswordBox x:Name="TxtDeepLKey" Margin="20,0,0,4" Height="24"/>
                <CheckBox x:Name="CbDeepLBackup" Margin="20,0,0,0" Content="Use DeepL when Google is busy or unreachable"/>

                <TextBlock Text="NEVER TRANSLATE THESE WORDS" Style="{StaticResource SectionHeader}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Guild names, friends' names, your own slang. Separate with commas. Albion cities, tiers and item links are already protected."/>
                <TextBox x:Name="TxtCustomTerms" Height="48" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="MEMORY" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="CbKeepCache" Content="Remember translations for 7 days (fewer messages sent)"/>
                <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,4" Text="Stores translated messages on this PC so repeats are not sent again after a restart. Off by default because the file contains other players' messages."/>
                <Button Content="Forget all translations" HorizontalAlignment="Left" Padding="8,2" FontSize="11" Margin="20,0,0,0" Click="BtnClearCache_Click"/>

                <TextBlock Text="OVERLAY" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Background" Foreground="#D0D0D0" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="SliderOpacity" Minimum="0" Maximum="1" Width="200" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox x:Name="CbOverlayTranslatedOnly" Content="Show only translated messages in the overlay"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Hotkeys (work while Albion has focus): Ctrl+Shift+R reply · Ctrl+Shift+O show/hide overlay · Ctrl+Shift+L unlock overlay to move it."/>

                <TextBlock Text="CHAT" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="CbGlobal" Content="Include global channels (trade, recruitment, help…)"/>
                <CheckBox x:Name="CbTopmost" Content="Keep this window on top of the game"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Skip messages with fewer letters than" Foreground="#D0D0D0" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtMinLetters" Width="36" Margin="8,0,0,0" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="TABS" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="TxtNoTabs" Style="{StaticResource Hint}"
                           Text="Your in-game chat tabs appear here after you log in to Albion while capturing."/>
                <StackPanel x:Name="TabPanel"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
