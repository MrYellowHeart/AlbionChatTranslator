<Window x:Class="AlbionChatTranslator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="400" SizeToContent="Height" MaxHeight="760"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <DockPanel Margin="20,10,20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="80" Margin="0,0,8,0" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="TRANSLATE CHAT INTO" Style="{StaticResource SectionHeader}"/>
                <ComboBox x:Name="CboLanguage" DisplayMemberPath="Name" Height="26"/>

                <TextBlock Text="TRANSLATOR" Style="{StaticResource SectionHeader}"/>
                <RadioButton x:Name="RbGoogle" GroupName="Provider" Content="Google Translate (recommended): free, no account"/>
                <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,8"
                           Text="Only the text of messages that are not in your language is sent. Never names, channels, item links or anything about you."/>

                <RadioButton x:Name="RbDeepL" GroupName="Provider" Content="DeepL: needs your own API key"/>
                <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,4"
                           Text="Often more natural for European languages. Free key: 500,000 characters/month. Stored encrypted with your Windows account."/>
                <PasswordBox x:Name="TxtDeepLKey" Margin="20,0,0,0" Height="24"/>

                <TextBlock Text="CHAT" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="CbGlobal" Content="Include global channels (trade, recruitment, help…)"/>
                <CheckBox x:Name="CbTopmost" Content="Keep window on top of the game"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Skip messages with fewer letters than" Foreground="#D0D0D0" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtMinLetters" Width="36" Margin="8,0,0,0" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="TABS" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="TxtNoTabs" Style="{StaticResource Hint}"
                           Text="Your in-game chat tabs appear here after you log in to Albion while capturing."/>
                <StackPanel x:Name="TabPanel"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
