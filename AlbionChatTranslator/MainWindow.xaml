<Window x:Class="AlbionChatTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Albion Chat Translator — by Tenith"
        Height="520" Width="760"
        MinHeight="320" MinWidth="480"
        Background="#1A1A1A"
        Topmost="True">

    <Window.Resources>

        <!-- Dark TabControl -->
        <Style TargetType="TabControl">
            <Setter Property="Background"  Value="#141414"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True"
                                      Background="#1E1E1E" Margin="0,4,0,0"/>
                            <Border Grid.Row="1" Background="#141414"
                                    BorderBrush="#333" BorderThickness="0,1,0,0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TabItem -->
        <Style TargetType="TabItem">
            <Setter Property="Background"  Value="#232323"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Padding"     Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="3,3,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,3,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#141414"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#555"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel Margin="8">

        <!-- Top toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="BtnStart" Content="▶ Start" Click="BtnStart_Click" Margin="0,0,4,0"/>
            <Button x:Name="BtnStop"  Content="■ Stop"  Click="BtnStop_Click"  Margin="0,0,8,0" IsEnabled="False"/>
            <TextBlock VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Margin="0,0,4,0">
                <Hyperlink RequestNavigate="LinkDeepL_RequestNavigate"
                           NavigateUri="https://www.deepl.com/en/pro-api#api-pricing"
                           Foreground="#666">DeepL</Hyperlink>
                <Run Foreground="#444"> / </Run>
                <Hyperlink RequestNavigate="LinkDeepL_RequestNavigate"
                           NavigateUri="https://www.deepl.com/en/your-account/keys"
                           Foreground="#666">key:</Hyperlink>
            </TextBlock>
            <PasswordBox x:Name="TxtApiKey" Width="180" VerticalAlignment="Center"
                         ToolTip="Paste your DeepL API key — click 'DeepL key:' to open your account page"/>
            <Button Content="Clear log" Click="BtnClear_Click" Margin="8,0,4,0"/>
            <Button Content="⚙ Settings" Click="BtnSettings_Click" Margin="0,0,4,0"/>
            <Button Content="? Help" Click="BtnHelp_Click" Margin="0,0,8,0"/>
            <TextBlock x:Name="TxtStatus" Text="Stopped" Foreground="#666"
                       VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
        </StackPanel>

        <!-- Bottom status bar -->
        <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Messages: " Foreground="#444" FontFamily="Consolas" FontSize="10"/>
                <TextBlock x:Name="TxtCount" Text="0" Foreground="#6A9FB5"
                           FontFamily="Consolas" FontSize="10" Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtError" Text="" Foreground="#C05050"
                           FontFamily="Consolas" FontSize="10"/>
            </StackPanel>
            <TextBlock Text="Made by Tenith" HorizontalAlignment="Right"
                       Foreground="#2E2E2E" FontFamily="Consolas" FontSize="10"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Chat tabs -->
        <TabControl x:Name="MainTabControl"/>

    </DockPanel>
</Window>
