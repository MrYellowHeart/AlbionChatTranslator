<Window x:Class="AlbionChatTranslator.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A">

    <StackPanel Margin="24">
        <TextBlock Text="Albion Chat Translator" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="Bold"/>
        <TextBlock x:Name="TxtVersion" Foreground="#666" FontSize="11" Margin="0,2,0,14"/>

        <TextBlock Text="Nothing shows up?" Foreground="#D0D0D0" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource Hint}" Text="• Make sure the status says Capturing, then send a message in Albion's Say chat."/>
        <TextBlock Style="{StaticResource Hint}" Text="• Tabs appear after you log in (or change zone) while capturing. Until then everything goes to 'All chat'."/>
        <TextBlock Style="{StaticResource Hint}" Text="• Some VPNs and ping reducers hide game traffic from Windows. Try with them off."/>
        <TextBlock Style="{StaticResource Hint}" Text="• After a big Albion patch the app may need an update; it installs updates by itself."/>

        <TextBlock Text="Hotkeys (work while Albion has focus)" Foreground="#D0D0D0" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <TextBlock Style="{StaticResource Hint}" Text="Ctrl+Shift+R: reply to whoever spoke last. Type in your language, press Enter, then Ctrl+V in Albion."/>
        <TextBlock Style="{StaticResource Hint}" Text="Ctrl+Shift+O: show or hide the see-through chat overlay. Ctrl+Shift+L: unlock it to move or resize, press again to lock. These work only when the overlay is enabled in Settings."/>
        <TextBlock Style="{StaticResource Hint}" Text="The overlay is off by default. Albion Online support has said third-party tools may not have an overlay on the game client and would not say whether this one counts, so turning it on is at your own risk."/>

        <TextBlock Text="Privacy" Foreground="#D0D0D0" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <TextBlock Style="{StaticResource Hint}" Text="Translators are tried in order: your own Microsoft or DeepL key (if you added one), then offline models on your PC (nothing sent), then Google Translate only for languages without an offline model. Offline packs for the languages you ticked in Settings download in the background. When something does go online, it is only the text of messages that are not in your languages, over HTTPS with no cookies or account. Player names, channels, item links and anything about you are never sent; the 'Sent for translation' counter shows exactly how many lines left your PC. The app also contacts github.com to check for updates. It only reads Albion's network traffic and never changes, sends or injects anything into the game."/>

        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0">
            <Hyperlink NavigateUri="https://github.com/MrYellowHeart/AlbionChatTranslator" RequestNavigate="Link_RequestNavigate" Foreground="{StaticResource Accent}">Source code, issues and releases</Hyperlink>
        </TextBlock>

        <Button Content="Close" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Width="90" Margin="0,12,0,0" Click="BtnClose_Click"/>
    </StackPanel>
</Window>
